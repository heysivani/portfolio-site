---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
---

<BaseLayout title="Coming soon | sivani.me" description="Coming soon">
	<SiteHeader />
	<div class="content">
		<main>
			<section class="hero">
				<a class="back-link" href="/">
					<svg viewBox="0 0 17 17" width="17" height="17" xmlns="http://www.w3.org/2000/svg">
						<path
							d="M9.1 3.7 L4.3 8.5 L9.1 13.3"
							stroke="currentColor"
							stroke-width="1"
							stroke-linecap="round"
							stroke-linejoin="round"
							fill="none"
						/>
						<path d="M4.3 8.5 H13.7" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" fill="none" />
					</svg>
					<span>Home</span>
				</a>
				<p class="coming-soon">Coming soon</p>
			</section>

			<div class="cta-wrap">
				<a class="cta-button" href="/">&larr; Home</a>
			</div>
		</main>
	</div>
	<SiteFooter />
</BaseLayout>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		padding: var(--space-padding-large);
		gap: var(--space-padding-medium);
	}

	.back-link {
		display: flex;
		align-items: center;
		gap: var(--space-micro);
		width: fit-content;
		text-decoration: none;
		color: var(--color-dark-gray);
		font-family: var(--font-display);
		font-size: var(--text-micro);
		transition: color 0.2s ease;
	}

	.back-link:hover {
		color: var(--color-medium-green);
	}

	.coming-soon {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-h1);
		font-weight: 500;
	}

	.cta-wrap {
		padding: 0 var(--space-padding-large) var(--space-padding-large);
	}

	.cta-button {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 33px;
		border: 1px solid var(--color-dark-gray);
		border-radius: 18px;
		background-color: var(--color-light-purple);
		font-family: var(--font-display);
		font-size: var(--text-micro);
		text-decoration: none;
		color: var(--color-dark-gray);
		transition: filter 0.2s ease;
	}

	.cta-button:hover {
		filter: brightness(0.93);
	}
</style>
