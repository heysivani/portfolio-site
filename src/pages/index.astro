---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout>
	<SiteHeader />
	<div class="content">
		<main>
			<Hero />
			<SectionHeading text="Featured projects" />
			<section class="work">
				<ProjectCard
					href="/projects/finding-the-why-behind-slides"
					image="/images/finding-the-why-behind-slides/project-1-title.svg"
					title="Finding the “why” behind slides"
					action="UX research to evaluate instructional materials."
					impact="Higher quality curriculum materials used across our B2B enterprise and B2C programs, more efficient time allocation for curriculum creators, and a higher level of design maturity within our organization."
					skills="Skills: user interviews, stakeholder interviews, usability tests, survey design, heuristic evaluations, competitive analysis, thematic analysis, quantitative and qualitative data analysis, data synthesis, workshop facilitation, ux design, project management"
				/>
				<ProjectCard
					href="/projects/increasing-b2b-traffic-the-power-of-navigation"
					image="/images/increasing-b2b-traffic-the-power-of-navigation/project-2-title.svg"
					title="Increasing B2B traffic: The power of navigation"
					action="Redesigned navigation, designed new pages, and updated B2B design system to align with new branding."
					impact="Higher traffic to our B2B pages, and better engagement (scroll percentage and clicks)."
					skills="Skills: heuristic evaluation, competitive analysis, workshop facilitation, stakeholder interviews, survey design, usability testing, data synthesis, information architecture, ux design, ui design, brand implementation, design systems, project management"
				/>
				<ProjectCard
					href="/projects/cta-getting-more-people-to-hit-apply"
					image="/images/cta-getting-more-people-to-hit-apply/project-3-title.svg"
					title="CTA: Getting more people to hit apply"
					action="Resolved critical issues that prevented prospective students from applying to our programs."
					impact="More apply button clicks and submissions of the application form, and less confusion from prospective students about basic program details."
					skills="Skills: heuristic evaluation, competitive analysis, workshop facilitation, stakeholder interviews, survey design, usability testing, data synthesis, ux design, ui design, brand implementation, design systems, project management"
				/>
			</section>
		</main>
	</div>
	<SiteFooter />
</BaseLayout>

<style>
	.work {
		display: flex;
		flex-direction: column;
		gap: var(--space-padding-large);
		padding: var(--space-padding-large);
	}
</style>
