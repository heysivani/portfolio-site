---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout>
	<SiteHeader />
	<div class="content">
		<main>
			<Hero />
			<SectionHeading text="Featured projects" />
			<section class="work">
				<ProjectCard
					href="/projects/ux-research-instructional-materials"
					image="/images/case-study-1-cover.png"
					title="UX Research to evaluate instructional materials"
					description="Uncovering issues and opportunities in the instructional design of our B2B and B2C technical programs"
					skills="Skills: user interviews, usability tests, survey design, heuristic evaluations, data analysis, workshop facilitation, project management"
				/>
				<ProjectCard
					href="/projects/website-redesign"
					image="/images/case-study-2-cover.svg"
					title="Improving a B2C Tech Bootcamp Admissions Pipeline"
					description="Discovered issues in information coherency and organization of content through research, designed solutions to resolve these issues, and implemented the changes myself in Webflow."
					skills="Skills: heuristic evaluation, competitive analysis, workshop facilitation, stakeholder interviews, survey design, usability testing, information architecture, ui design, data synthesis, project management"
				/>
				<ProjectCard
					href="/projects/b2b-navigation-toggle"
					image="/images/case-study-3-cover.svg"
					title="Increasing B2B Traffic: One Confusing Toggle"
					description="Updated our design system to fit new B2B brand guidelines, and discovered a critical issue that was bottlenecking the number of users that landed on our B2B pages."
					skills="Skills: stakeholder management, design systems, brand implementation, navigation design, ui design, analytics review, project management"
				/>
			</section>
		</main>
	</div>
	<SiteFooter />
</BaseLayout>

<style>
	.work {
		display: flex;
		flex-direction: column;
		gap: var(--space-padding-large);
		padding: var(--space-padding-large);
	}
</style>
