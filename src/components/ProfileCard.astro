---
import SocialLinks from './SocialLinks.astro';

const abilities = ['UX research', 'UI design', 'Coding'];
---

<div class="profile-card">
	<div class="profile-card__header">
		<p>Profile</p>
	</div>
	<div class="profile-card__body">
		<div class="profile-row">
			<div class="photo">
				<img src="/images/profile.png" alt="Portrait of Sivani" width="145" height="138" />
			</div>
			<div class="stats">
				<div class="stats__info">
					<div class="stat">
						<img src="/icons/skull.svg" alt="" width="15" height="14" />
						<span>Level unknown</span>
					</div>
					<div class="stat">
						<img src="/icons/location.svg" alt="" width="12" height="15" />
						<span>Tokyo</span>
					</div>
				</div>
				<div class="abilities">
					<p class="abilities__label">Special abilities</p>
					<ul>
						{
							abilities.map((ability) => (
								<li>
									<svg class="ability-marker" viewBox="0 0 11.681 13.0863" width="15" height="13" xmlns="http://www.w3.org/2000/svg">
										<path d="M4.67995 12.3252C5.11947 13.3398 6.55822 13.34 6.99798 12.3255L11.5754 1.76554C11.937 0.93144 11.3256 0 10.4165 0H5.84076H1.26454C0.355578 0 -0.25585 0.931198 0.105459 1.76526L4.67995 12.3252Z" />
									</svg>
									<span>{ability}</span>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</div>

		<div class="bars">
			<div class="bar-row">
				<span class="bar-label">HP</span>
				<div class="bar bar--hp"></div>
			</div>
			<div class="bar-row">
				<span class="bar-label">XP</span>
				<div class="bar bar--xp"></div>
			</div>
		</div>

		<p class="bio-text">
			Full-stack UX + UI product designer powered by a game design degree and a background in coding and ed tech. Values
			data-driven decisions, clarity, and kindness. Writer of an award-nominated game that has been exhibited worldwide.
		</p>

		<SocialLinks animate startDelay={0} />
	</div>
</div>

<script>
	const abilities = document.querySelector('.abilities');

	if (abilities instanceof HTMLElement && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		let ticking = false;
		let triggerLine = 0;
		let rampDistance = 1;

		// medium-green -> light-green, matching --color-medium-green / --color-light-green
		const fromColor = [83, 196, 156];
		const toColor = [213, 238, 216];

		const measure = () => {
			// Animation doesn't start until the triangles have scrolled up past a
			// line 3/5 of the way up the viewport (i.e. 2/5 down from the top),
			// then ramps over the next couple fifths of scrolling.
			triggerLine = window.innerHeight * 0.4;
			rampDistance = Math.max(window.innerHeight * 0.4, 1);
		};

		const updateProgress = () => {
			// Also require actual scrolling to have happened, so a viewport tall
			// enough to fit the whole page can't show progress before any
			// interaction, even if the element's position would otherwise say so.
			const rect = abilities.getBoundingClientRect();
			const progress = window.scrollY <= 0 ? 0 : Math.max(0, Math.min(1, (triggerLine - rect.top) / rampDistance));
			abilities.style.setProperty('--ability-progress', progress.toFixed(3));

			const [r, g, b] = fromColor.map((from, i) => Math.round(from + (toColor[i] - from) * progress));
			abilities.style.setProperty('--ability-color', `rgb(${r}, ${g}, ${b})`);

			ticking = false;
		};

		const onScroll = () => {
			if (!ticking) {
				window.requestAnimationFrame(updateProgress);
				ticking = true;
			}
		};

		const onResize = () => {
			measure();
			updateProgress();
		};

		measure();
		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', onResize);
		updateProgress();
	}
</script>

<style>
	.profile-card {
		width: 100%;
		background-color: var(--color-light-purple);
		border: 1px solid var(--color-dark-gray);
		border-radius: 5px;
		box-shadow: 0 8px 8px rgba(124, 112, 132, 0.12);
	}

	.profile-card__header {
		padding: var(--space-medium) var(--space-padding-medium);
		border-bottom: 1px solid var(--color-dark-gray);
	}

	.profile-card__header p {
		font-family: var(--font-display);
		font-size: var(--text-h3);
		font-weight: 400;
	}

	.profile-card__body {
		display: flex;
		flex-direction: column;
		gap: var(--space-medium);
		background-color: var(--color-cream);
		border-radius: 0 0 5px 5px;
		padding: var(--space-padding-medium);
	}

	.profile-row {
		display: flex;
		gap: var(--space-large);
		padding-bottom: var(--space-micro);
	}

	.photo {
		position: relative;
		flex-shrink: 0;
		width: 145px;
		height: 138px;
		border: 1px solid var(--color-dark-gray);
		border-radius: 5px;
		background-color: var(--color-light-purple);
		overflow: hidden;
		animation: pop-in 0.5s ease-out both;
	}

	.photo img {
		position: absolute;
		width: 262.51%;
		height: 155.15%;
		max-width: none;
		left: -23.17%;
		top: -19.15%;
	}

	.stats {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-medium);
		justify-content: center;
	}

	.stats__info {
		display: flex;
		flex-direction: column;
		gap: var(--space-micro);
	}

	.stat {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: var(--text-micro);
		color: var(--color-light-grey);
		animation: pop-in 0.5s ease-out both;
	}

	.stat:nth-child(1) {
		animation-delay: 0s;
	}

	.stat:nth-child(2) {
		animation-delay: 0.08s;
	}

	.stat img {
		flex-shrink: 0;
	}

	.abilities {
		--ability-progress: 0;
		--ability-color: var(--color-medium-green);
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding-bottom: var(--space-small);
	}

	.abilities__label {
		font-size: var(--text-micro);
		font-weight: 700;
		color: var(--color-light-grey);
		animation: pop-in 0.5s ease-out both;
		animation-delay: 0.16s;
	}

	.abilities ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.abilities li {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: var(--text-micro);
		color: var(--color-light-grey);
		animation: pop-in 0.5s ease-out both;
	}

	.abilities li:nth-child(1) {
		animation-delay: 0.24s;
	}

	.abilities li:nth-child(2) {
		animation-delay: 0.32s;
	}

	.abilities li:nth-child(3) {
		animation-delay: 0.4s;
	}

	@keyframes pop-in {
		0% {
			opacity: 0;
			transform: scale(0.9);
		}
		60% {
			opacity: 1;
			transform: scale(1.05);
		}
		100% {
			opacity: 1;
			transform: scale(1);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.photo,
		.stat,
		.abilities__label,
		.abilities li,
		.bar-label,
		.bio-text {
			animation: none;
		}
	}

	.ability-marker {
		flex-shrink: 0;
		display: block;
		will-change: transform;
		transform: rotate(calc(-90deg + var(--ability-progress) * 90deg));
	}

	.ability-marker path {
		fill: var(--ability-color);
	}

	.bars {
		display: flex;
		flex-direction: column;
		gap: 3px;
	}

	.bar-row {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.bar-label {
		flex-shrink: 0;
		width: 15px;
		font-size: var(--text-micro);
		color: var(--color-light-grey);
		animation: pop-in 0.5s ease-out both;
	}

	.bar-row:nth-child(1) .bar-label {
		animation-delay: 0s;
	}

	.bar-row:nth-child(2) .bar-label {
		animation-delay: 0.08s;
	}

	.bar {
		flex: 1;
		height: 7px;
		border-radius: 5px;
		transform: scaleX(0);
		transform-origin: left;
		opacity: 0.35;
		animation: bar-fill 1s ease-out forwards;
	}

	@keyframes bar-fill {
		to {
			transform: scaleX(1);
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.bar {
			animation: none;
			transform: scaleX(1);
			opacity: 1;
		}

		.abilities {
			--ability-progress: 1;
			--ability-color: var(--color-light-green);
		}
	}

	.bar--hp {
		background-color: var(--color-medium-green);
		/* Starts once the "HP" label's own pop-in (0s delay + 0.5s duration)
		   has finished settling. */
		animation-delay: 0.5s;
	}

	.bar--xp {
		background-color: var(--color-medium-purple);
		/* Starts once the "XP" label's own pop-in (0.08s delay + 0.5s duration)
		   has finished settling. */
		animation-delay: 0.58s;
	}

	.bio-text {
		font-size: var(--text-body);
		line-height: 1.5;
		animation: fade-in-scale 0.9s ease-out both;
		/* Starts alongside the level/skull row. */
		animation-delay: 0s;
	}

	@keyframes fade-in-scale {
		from {
			opacity: 0;
			transform: scale(0.95);
		}
		to {
			opacity: 1;
			transform: scale(1);
		}
	}
</style>
