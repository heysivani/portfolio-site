---
interface Props {
	text: string;
}

const { text } = Astro.props;
---

<div class="section-heading">
	<img class="marker marker--left" src="/icons/triangles.svg" alt="" width="12" height="49" />
	<h2>{text}</h2>
	<img class="marker marker--right" src="/icons/triangles.svg" alt="" width="12" height="49" />
</div>

<style>
	.section-heading {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-large);
		padding: var(--space-padding-medium) var(--space-padding-large);
	}

	h2 {
		flex: 1;
		margin: 0;
		text-align: center;
		font-family: var(--font-display);
		font-size: var(--text-h1);
		font-weight: 500;
	}

	.marker {
		flex-shrink: 0;
	}
</style>
