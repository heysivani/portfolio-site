---
import ProfileCard from './ProfileCard.astro';
---

<section class="hero">
	<div class="hero__headline">
		<div class="headline">
			<h1>
				Hi!<br class="hero-break" /><br class="hero-break" />
				I'm
				<span class="name-block">
					<span class="name-anchor">Sivani<span class="romaji">シバーニ</span></span
					><span class="pronunciation">/shi-vah-nee/</span>
				</span>
				<br /><br />
				I'm a designer, writer, and developer.
			</h1>
		</div>
	</div>

	<div class="hero__card">
		<ProfileCard />
	</div>
</section>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		padding: var(--space-padding-large);
		gap: var(--space-padding-large);
	}

	.headline h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-h1);
		font-weight: 500;
		line-height: 1.4;
	}

	/* Suppressed at mobile so "Hi!" and "I'm Sivani..." stay on one line as
	   before; re-enabled at desktop (see below) to match the Figma frame,
	   which gives "Hi!" its own line. display:none removes the break itself
	   but the surrounding whitespace still collapses to a single space, so
	   this doesn't change the mobile copy or spacing at all. */
	.hero-break {
		display: none;
	}

	.name-anchor {
		position: relative;
		display: inline-block;
	}

	.romaji {
		position: absolute;
		left: 50%;
		top: -10.2px;
		transform: translateX(-50%);
		font-family: var(--font-body);
		font-size: 9px;
		font-weight: 400;
		color: var(--color-light-grey);
		white-space: nowrap;
	}

	.pronunciation {
		display: inline-block;
		position: relative;
		top: -1px;
		vertical-align: baseline;
		margin-left: 6px;
		font-family: var(--font-body);
		font-size: var(--text-micro);
		font-weight: 400;
		color: var(--color-light-grey);
		white-space: nowrap;
	}

	/* Desktop-only restructure (per Figma node 4294:1308): profile card on
	   the left at its own comfortable width, headline on the right filling
	   whatever space is left. The headline's font-size scales fluidly with
	   that leftover space via a container query, instead of jumping between
	   fixed sizes at breakpoints like the rest of the site's type — the
	   whole point here is that it should keep sitting "nicely" next to the
	   card at any width, not just at a few fixed ones. Below 1280px is
	   untouched — same .hero flex column, same fixed type scale, same
	   pronunciation-inline-beside-the-name layout as always. 1280px (not the
	   usual 1024px desktop tier) is used for the same reason as the previous
	   hero pass: --content-max-width is still only 640px at 1024px, not
	   enough room for two columns. */
	@media (min-width: 1280px) {
		.hero {
			display: grid;
			grid-template-columns: minmax(360px, 560px) 1fr;
			grid-template-areas: 'card headline';
			align-items: start;
			gap: var(--space-large);
		}

		.hero__card {
			grid-area: card;
		}

		.hero__headline {
			grid-area: headline;
			/* The font-size clamp below reads this element's own rendered
			   width via cqw, not the viewport's — so it tracks exactly how
			   much room is left after the card, at any breakpoint. */
			container-type: inline-size;
		}

		.headline h1 {
			font-size: clamp(32px, 19px + 7.4cqw, 72px);
			line-height: 1.3;
		}

		.hero-break {
			display: inline;
		}

		/* Stacks the name above its pronunciation instead of running them on
		   the same line — .romaji stays absolutely positioned against
		   .name-anchor either way, so it doesn't need to move. */
		.name-block {
			display: inline-flex;
			flex-direction: column;
			align-items: center;
			gap: 0.1em;
		}

		.romaji {
			top: -1.3em;
			font-size: 0.32em;
		}

		.pronunciation {
			display: block;
			position: static;
			top: auto;
			margin-left: 0;
			font-size: 0.32em;
		}
	}
</style>
