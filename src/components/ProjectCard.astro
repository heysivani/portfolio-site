---
interface Props {
	href: string;
	image: string;
	title: string;
	description: string;
}

const { href, image, title, description } = Astro.props;
---

<a class="project-card" href={href}>
	<div class="project-card__image">
		<img src={image} alt="" />
	</div>
	<div class="project-card__text">
		<h3>{title}</h3>
		<p>{description}</p>
	</div>
</a>

<style>
	.project-card {
		display: flex;
		flex-direction: column;
		gap: var(--space-large);
		text-decoration: none;
		color: inherit;
	}

	.project-card__image {
		aspect-ratio: 2000 / 1125;
		border: 3px solid var(--color-medium-green);
		border-radius: 5px;
		overflow: hidden;
	}

	.project-card__image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.project-card__text {
		display: flex;
		flex-direction: column;
		gap: var(--space-medium);
	}

	.project-card__text h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-h2);
		font-weight: 500;
	}

	.project-card__text p {
		font-size: var(--text-body);
		line-height: 1.5;
	}
</style>
