---
interface Props {
	href: string;
	image: string;
	title: string;
	description: string;
	skills: string;
}

const { href, image, title, description, skills } = Astro.props;
---

<a class="project-card" href={href}>
	<div class="project-card__body">
		<div class="project-card__image">
			<img src={image} alt="" />
		</div>
		<div class="project-card__text">
			<h3>{title}</h3>
			<hr />
			<p>{description}</p>
			<hr />
			<p class="project-card__skills">{skills}</p>
		</div>
	</div>
	<div class="project-card__cta">View project &rarr;</div>
</a>

<style>
	.project-card {
		display: block;
		border: 1px solid var(--color-dark-gray);
		border-radius: 5px;
		box-shadow: 0 8px 16px rgba(124, 112, 132, 0.12);
		text-decoration: none;
		color: inherit;
	}

	.project-card__body {
		padding: var(--space-padding-medium);
	}

	.project-card__image {
		aspect-ratio: 2000 / 1125;
		border: 1px solid var(--color-dark-gray);
		border-radius: 5px;
		overflow: hidden;
	}

	.project-card__image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.project-card__text {
		display: flex;
		flex-direction: column;
		gap: var(--space-large);
		padding-top: var(--space-large);
	}

	.project-card__text h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-h2);
		font-weight: 500;
	}

	.project-card__text hr {
		width: 100%;
		height: 1px;
		margin: 0;
		border: none;
		background-color: var(--color-light-grey);
		border-radius: 5px;
	}

	.project-card__text p {
		margin: 0;
		font-size: var(--text-body);
		line-height: 1.5;
	}

	.project-card__skills {
		font-size: var(--text-micro);
		color: var(--color-light-grey);
	}

	.project-card__cta {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 33px;
		border-top: 1px solid var(--color-dark-gray);
		border-radius: 0 0 5px 5px;
		background-color: var(--color-light-green);
		font-family: var(--font-display);
		font-size: var(--text-micro);
	}
</style>
