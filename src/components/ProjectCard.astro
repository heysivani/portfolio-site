---
interface Props {
	href: string;
	image: string;
	title: string;
	action: string;
	impact: string;
	skills: string;
}

const { href, image, title, action, impact, skills } = Astro.props;
---

<a class="project-card" href={href}>
	<div class="project-card__body">
		<h3 class="project-card__title">{title}</h3>
		<div class="project-card__image">
			<img src={image} alt="" />
		</div>
		<div class="project-card__details">
			<hr />
			<div class="project-card__action-impact">
				<div class="project-card__group">
					<h4 class="project-card__label">Action</h4>
					<p>{action}</p>
				</div>
				<div class="project-card__group">
					<h4 class="project-card__label">Impact</h4>
					<p>{impact}</p>
				</div>
			</div>
			<hr />
			<p class="project-card__skills">{skills}</p>
		</div>
	</div>
	<div class="project-card__cta">View project &rarr;</div>
</a>

<style>
	.project-card {
		display: block;
		position: relative;
		border: 1px solid var(--color-dark-gray);
		border-radius: 5px;
		box-shadow: 0 8px 16px rgba(124, 112, 132, 0.12);
		text-decoration: none;
		color: inherit;
		transition: transform 0.2s ease-out;
	}

	.project-card:hover,
	.project-card:focus-visible {
		transform: scale(1.05);
	}

	@media (prefers-reduced-motion: reduce) {
		.project-card {
			transition: none;
		}
	}

	.project-card__body {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: var(--space-large);
		padding: var(--space-padding-medium);
	}

	.project-card__title {
		order: 2;
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-h2);
		font-weight: 500;
	}

	.project-card__image {
		order: 1;
		aspect-ratio: 2000 / 1125;
		border: 1px solid var(--color-dark-gray);
		border-radius: 5px;
		overflow: hidden;
	}

	.project-card__image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.project-card__details {
		order: 3;
		display: flex;
		flex-direction: column;
		gap: var(--space-large);
	}

	.project-card__details hr {
		width: 100%;
		height: 1px;
		margin: 0;
		border: none;
		background-color: var(--color-light-grey);
		border-radius: 5px;
	}

	.project-card__details p {
		margin: 0;
		font-size: var(--text-body);
		line-height: 1.5;
	}

	.project-card__action-impact {
		display: flex;
		flex-direction: column;
		gap: var(--space-large);
	}

	.project-card__group {
		display: flex;
		flex-direction: column;
		gap: var(--space-tiny);
	}

	.project-card__label {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-h3);
		font-weight: 400;
		color: var(--color-light-grey);
	}

	.project-card__skills {
		font-size: var(--text-micro);
		color: var(--color-light-grey);
	}

	.project-card__cta {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		height: 50px;
		border-top: 1px solid var(--color-dark-gray);
		border-radius: 0 0 5px 5px;
		background-color: var(--color-light-green);
		font-family: var(--font-display);
		font-size: var(--text-micro);
	}

	:global([data-theme='dark']) .project-card__cta {
		background-color: var(--color-dark-purple);
	}

	/* Desktop-only restructure (per Figma node 4273:371): the title moves to
	   its own full-width row above the image, and the image sits beside the
	   action/impact/skills details instead of stacking above them. Below
	   1024px (including the 600px tablet tier) is untouched — same elements,
	   same DOM order, just a grid instead of the ordered flex column above
	   this point. */
	@media (min-width: 1024px) {
		.project-card__body {
			display: grid;
			grid-template-columns: 1fr 1fr;
			grid-template-areas:
				'title title'
				'image details';
			gap: var(--space-large);
		}

		.project-card__title {
			grid-area: title;
		}

		.project-card__image {
			grid-area: image;
			aspect-ratio: unset;
			height: 100%;
		}

		.project-card__details {
			grid-area: details;
		}
	}
</style>
