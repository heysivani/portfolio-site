<header class="site-header">
	<img class="logo" src="/images/logo.svg" alt="sivani" width="152" height="41" />
</header>

<style>
	.site-header {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 124px;
		padding: 32px 20px;
		position: sticky;
		top: 0;
		z-index: 10;
		overflow: hidden;
		background-color: var(--color-cream);
		border-bottom: 3px solid var(--color-light-purple);
	}

	.site-header::before {
		content: '';
		position: absolute;
		inset: 0;
		opacity: 0.6;
		background-image:
			linear-gradient(45deg, var(--color-light-purple) 25%, transparent 25%),
			linear-gradient(-45deg, var(--color-light-purple) 25%, transparent 25%),
			linear-gradient(45deg, transparent 75%, var(--color-light-purple) 75%),
			linear-gradient(-45deg, transparent 75%, var(--color-light-purple) 75%);
		background-size: 29px 29px;
		background-position:
			0 0,
			0 15px,
			15px -15px,
			-15px 0;
	}

	.logo {
		position: relative;
		height: 41px;
		width: auto;
	}
</style>
