---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<section class="case-study-block">
	<h3>{title}</h3>
	<div class="case-study-block__body">
		<slot />
	</div>
</section>

<style>
	.case-study-block {
		display: flex;
		flex-direction: column;
		gap: var(--space-padding-large);
		padding: var(--space-padding-large);
	}

	.case-study-block__body :global(.case-study-block__image) {
		aspect-ratio: 2000 / 1125;
		border: 1px solid var(--color-dark-gray);
		border-radius: 5px;
		overflow: hidden;
	}

	.case-study-block__body :global(.case-study-block__image img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.case-study-block h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-h2);
		font-weight: 500;
		color: var(--color-dark-gray);
	}

	.case-study-block__body {
		display: flex;
		flex-direction: column;
		gap: var(--space-padding-medium);
		font-size: var(--text-body);
		line-height: 1.5;
	}

	.case-study-block__body :global(p) {
		margin: 0;
	}

	.case-study-block__body :global(h4) {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-h3);
		font-weight: 400;
		color: var(--color-light-grey);
	}

	.case-study-block__body :global(ul) {
		margin: 0;
		padding-left: 1.2em;
		display: flex;
		flex-direction: column;
		gap: var(--space-medium);
	}

	/* A nested <ul> sits inside its parent <li> as plain block content, so it
	   has no gap of its own from the label text above it (li isn't a flex
	   container) — this margin matches that gap to the space the outer ul's
	   `gap` already gives between sibling bullets. */
	.case-study-block__body :global(li > ul) {
		margin-top: var(--space-medium);
	}
</style>
