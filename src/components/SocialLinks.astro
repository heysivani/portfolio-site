---
interface Props {
	animate?: boolean;
	startDelay?: number;
}

const { animate = false, startDelay = 0 } = Astro.props;

const links = [
	{ href: 'mailto:chatwithsivani@gmail.com', label: 'Email', icon: '/icons/mail.svg', size: 25 },
	{ href: 'https://www.linkedin.com/in/heysivani/', label: 'LinkedIn', icon: '/icons/linkedin.svg', size: 20 },
	{ href: 'https://github.com/heysivani', label: 'GitHub', icon: '/icons/github.svg', size: 20 },
];
---

<ul class:list={['social-links', { 'social-links--animated': animate }]}>
	{
		links.map((link, i) => (
			<li style={animate ? { animationDelay: `${(startDelay + i * 0.08).toFixed(2)}s` } : undefined}>
				<a class="social-links__link" href={link.href} aria-label={link.label} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noreferrer' : undefined}>
					{link.label === 'Email' ? (
						<svg width={link.size} height={link.size} viewBox="0 0 25 26" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
							<path d="M20.7031 4.87529H4.29687C3.21818 4.87529 2.34374 5.78472 2.34374 6.90654V19.094C2.34374 20.2159 3.21818 21.1253 4.29687 21.1253H20.7031C21.7818 21.1253 22.6562 20.2159 22.6562 19.094V6.90654C22.6562 5.78472 21.7818 4.87529 20.7031 4.87529Z" fill="#C894E9" />
							<path class="mail-icon__line" d="M6.49991 9.36331L12.4999 13.3633L18.4999 9.36331" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					) : (
						<img src={link.icon} alt="" width={link.size} height={link.size} />
					)}
				</a>
			</li>
		))
	}
</ul>

<script>
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (!reduceMotion) {
		const icons = document.querySelectorAll('.social-links__link');

		icons.forEach((icon) => {
			icon.addEventListener('pointerenter', () => {
				// Restart from scratch even if already mid-animation, and let it
				// keep playing after the pointer leaves (it's not tied to :hover).
				icon.classList.remove('is-hovering');
				void icon.getBoundingClientRect();
				icon.classList.add('is-hovering');
			});

			icon.addEventListener('animationend', () => {
				icon.classList.remove('is-hovering');
			});
		});
	}
</script>

<style>
	.social-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: var(--space-micro) var(--space-large);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.social-links a {
		display: block;
		line-height: 0;
	}

	.mail-icon__line {
		stroke: var(--color-cream);
	}

	.social-links--animated li {
		animation: pop-in 0.5s ease-out both;
	}

	@keyframes pop-in {
		0% {
			opacity: 0;
			transform: scale(0.9);
		}
		60% {
			opacity: 1;
			transform: scale(1.05);
		}
		100% {
			opacity: 1;
			transform: scale(1);
		}
	}

	.social-links__link.is-hovering {
		animation: icon-squash-stretch 0.5s ease-in-out;
	}

	@keyframes icon-squash-stretch {
		0% {
			transform: scale(1, 1);
		}
		25% {
			transform: scale(1.08, 0.94);
		}
		50% {
			transform: scale(0.95, 1.07);
		}
		70% {
			transform: scale(1.03, 0.98);
		}
		85% {
			transform: scale(0.99, 1.01);
		}
		100% {
			transform: scale(1, 1);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.social-links--animated li {
			animation: none;
		}

		.social-links__link.is-hovering {
			animation: none;
		}
	}
</style>
