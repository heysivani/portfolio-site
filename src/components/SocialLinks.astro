---
const links = [
	{ href: 'mailto:hello@sivani.me', label: 'Email', icon: '/icons/mail.svg', size: 25 },
	{ href: 'https://www.linkedin.com/', label: 'LinkedIn', icon: '/icons/linkedin.svg', size: 20 },
	{ href: 'https://github.com/', label: 'GitHub', icon: '/icons/github.svg', size: 20 },
];
---

<ul class="social-links">
	{
		links.map((link) => (
			<li>
				<a href={link.href} aria-label={link.label} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noreferrer' : undefined}>
					<img src={link.icon} alt="" width={link.size} height={link.size} />
				</a>
			</li>
		))
	}
</ul>

<style>
	.social-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: var(--space-micro) var(--space-large);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.social-links a {
		display: block;
		line-height: 0;
	}
</style>
