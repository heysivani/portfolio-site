---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'sivani.me',
	description = 'Full-stack UX + UI product designer powered by a game design degree and a background in coding and ed tech.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
